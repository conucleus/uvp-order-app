{
  "name": "@uvp-eth/order-kernel",
  "version": "0.1.0",
  "description": "Headless order kernel: Product API transport, stage escrow, participant session and wallet interfaces.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./product": "./src/product/index.ts",
    "./product/v3": "./src/product/v3/index.ts",
    "./product/v3/*": "./src/product/v3/*.ts",
    "./escrow": "./src/escrow/index.ts",
    "./escrow/v3": "./src/escrow/v3/index.ts",
    "./*": "./src/*.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@uvp-eth/executor-kit": "workspace:*",
    "@uvp-eth/product-dto": "workspace:*",
    "viem": "^2.21.58",
    "@uvp-eth/protocol-bindings": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.15.3",
    "tsx": "^4.20.6"
  }
}
