{
  "name": "@uvp-eth/order-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:configured": "UVP_ORDER_APP_E2E_PROFILE=configured playwright test",
    "readiness": "pnpm typecheck && pnpm build && pnpm test && pnpm test:e2e && pnpm test:e2e:configured"
  },
  "dependencies": {
    "@uvp-eth/uvp-client": "workspace:*",
    "lucide-react": "^1.7.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
