# uvp-order-app 链直连 demo B 构建期环境变量示例。
# 复制为 .env.local（或部署环境的等价注入方式）后填写；缺必填项时外壳
# fail-closed 并显式列出缺失项，不猜测默认链或合约地址。

# UVPStateMachine 合约地址（必填）。
VITE_UVP_STATE_MACHINE=0x0000000000000000000000000000000000000000

# 链 ID（必填，正整数）：钱包网络必须与之一致。
VITE_CHAIN_ID=31337

# 只读 RPC URL（必填，http(s)）：读订单事实/事件、预检交易。
VITE_RPC_URL=http://127.0.0.1:8545

# 事件扫描起点（可选，非负整数；缺省 0）。
# VITE_UVP_FROM_BLOCK=0
