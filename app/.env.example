# uvp-order-app 前端构建期环境变量示例。
# 复制为 .env.local（或部署环境的等价注入方式）后按部署填写；
# 缺必填项时对应功能 fail-closed 显式失败，不回落到假可用状态。

# Chain Services 地址（必填）：参与者控制台读写的 Product API base URL；
# 缺配置时外壳 fail-closed，不渲染任务与证明。
VITE_UVP_CHAIN_SERVICES_URL=http://127.0.0.1:8787

# 状态机部署地址（任务提交签名必填）：提交签名域交叉核对的预期值，来自
# 部署配置注入而非被核对的同一 BFF 响应；缺配置或格式非法时拒绝签名。
# 构建期钉死的单地址（Vite 内联进产物，运行期改环境变量不生效）：状态机
# 部署轮换后必须重建前端，签名域门才会按新地址核对。
VITE_UVP_STATE_MACHINE_ADDRESS=0xREPLACE_WITH_DEPLOYED_STATE_MACHINE_ADDRESS

# 阶段补丁模块地址（阶段补丁签名必填）：executor/resource patch 的
# EIP-712 域由 UVPStagePatchModule 验签，不是任务投影里的状态机地址；
# 预期值同样来自部署配置注入，缺配置或格式非法时拒绝签名。构建期钉死，
# 同上。地址占位值是格式非法的：照抄部署会走"地址未配置"的显式报错
# 分支，而不是通过格式门后在每次签名时报与占位值不一致。
VITE_UVP_STAGE_PATCH_MODULE_ADDRESS=0xREPLACE_WITH_DEPLOYED_STAGE_PATCH_MODULE_ADDRESS

# 部署链 ID（可选）：提交与阶段补丁两个签名域共用的加强锚；只认十进制
# 正整数，其他格式拒绝签名。未声明时只保留信封校验里的链 ID 形状判定。
# VITE_UVP_CHAIN_ID=84532

# 参与者默认钱包（可选）：构建期注入的静态身份；运行期钱包覆盖只在
# local/dev 运行档开放。
# VITE_UVP_ORDER_APP_WALLET_ADDRESS=
# VITE_UVP_RUNTIME_ENV=

# 读/写超时（毫秒，可选）：缺省 6000；证据上传单独放宽（缺省 60000）。
# VITE_UVP_ORDER_APP_FETCH_TIMEOUT_MS=6000
# VITE_UVP_ORDER_APP_UPLOAD_TIMEOUT_MS=60000
